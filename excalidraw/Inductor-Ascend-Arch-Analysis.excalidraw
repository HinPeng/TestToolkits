ed":false,"locked":false,"strokeColor":"#1e1e1e","link":null,"endArrowhead":null,"roughness":1,"groupIds":[],"startBinding":null,"index":"b30","startArrowhead":null,"backgroundColor":"transparent","endBinding":null,"angle":0,"fillStyle":"solid","strokeWidth":2,"version":638,"roundness":{"type":2},"type":"line","updated":1780456933359,"id":"KixjJ5pAgpaShiR8PKloV","x":5864.8593750000018,"seed":546957713,"boundElements":[],"y":1319.8394789604672,"opacity":100,"height":0,"points":[[0,0],[-1771.5040885526173,0]],"width":1771.5040885526173,"frameId":"frame_scheduling","polygon":false,"strokeStyle":"solid","versionNonce":1280431135},{"isDeleted":false,"locked":false,"strokeColor":"#047857","link":null,"roughness":0,"groupIds":[],"index":"b32","backgroundColor":"#a7f3d0","angle":0,"fillStyle":"solid","strokeWidth":2,"version":513,"roundness":{"type":3},"type":"rectangle","updated":1780457766891,"id":"otaLMLqVRT1ArS6UWdSGs","x":4132.0691964285716,"seed":1886704369,"boundElements":[],"y":1340.3980538504472,"opacity":100,"height":200.57477678571405,"width":1663.8392857142851,"frameId":"frame_scheduling","strokeStyle":"solid","versionNonce":838521777},{"seed":831350111,"strokeStyle":"solid","id":"o71F1zD69hRCyTvL8OiOG","strokeWidth":1,"roughness":0,"isDeleted":false,"fontSize":25.386904761904812,"opacity":100,"verticalAlign":"top","text":"风险点：\n1（高）. 线性化兜底路径处理不够干净（耦合过多模块）：当前并不是直接根据 node 类型来分流，而是优先尝试 NPUTritonScheduling，\n通过 tilegen 给到一个 config 去尝试编译出 ttir，成功即视为可线性化，失败即视为不可线性化。— 耦合了后续\ncodegen\/tilegen\/compile 模块，且存在误判情况\n2（低）. 重构 NPUTritonScheduling.can_fuse 以更方便后续版本升级\n3（低）. scheduler.py 中的 patch 是否有更好实现方式？","updated":1780457732709,"locked":false,"version":1386,"autoResize":false,"type":"text","backgroundColor":"transparent","index":"b33","roundness":null,"containerId":null,"originalText":"风险点：\n1（高）. 线性化兜底路径处理不够干净（耦合过多模块）：当前并不是直接根据 node 类型来分流，而是优先尝试 NPUTritonScheduling，通过 tilegen 给到一个 config 去尝试编译出 ttir，成功即视为可线性化，失败即视为不可线性化。— 耦合了后续 codegen\/tilegen\/compile 模块，且存在误判情况\n2（低）. 重构 NPUTritonScheduling.can_fuse 以更方便后续版本升级\n3（低）. scheduler.py 中的 patch 是否有更好实现方式？","height":190.40178571428609,"link":null,"strokeColor":"#374151","fillStyle":"solid","groupIds":[],"versionNonce":1780140785,"textAlign":"left","fontFamily":3,"lineHeight":1.25,"frameId":"frame_scheduling","boundElements":[],"x":4152.4402901785743,"angle":0,"y":1344.1810128348216,"width":1631.1735052890206}],"files":{},"version":2,"type":"excalidraw","appState":{"shouldCacheIgnoreZoom":false,"exportScale":2,"defaultSidebarDockedPreference":false,"openMenu":null,"showWelcomeScreen":true,"currentItemStrokeColor":"#0c8599","bindMode":"orbit","exportWithDarkMode":true,"lockedMultiSelections":{},"currentItemRoughness":1,"currentItemTextAlign":"left","exportBackground":true,"scrolledOutside":false,"selectedElementIds":{},"zenModeEnabled":false,"currentItemStartArrowhead":null,"zoom":{"value":0.69999999999999996},"theme":"dark","activeTool":{"locked":false,"fromSelection":false,"lastActiveTool":null,"type":"selection","customType":null},"exportEmbedScene":false,"gridStep":5,"lastPointerDownWith":"mouse","selectedGroupIds":{},"currentItemBackgroundColor":"#99e9f2","scrollY":-11.494419642855348,"penDetected":false,"viewBackgroundColor":"#ffffff","isBindingEnabled":true,"currentItemFontFamily":3,"isMidpointSnappingEnabled":true,"currentItemArrowType":"round","name":"Untitled-2026-06-03-0948","currentItemOpacity":100,"preferredSelectionTool":{"type":"selection","initialized":true},"scrollX":-5475.3448660714312,"stats":{"panels":3,"open":false},"objectsSnapModeEnabled":false,"gridSize":20,"gridModeEnabled":false,"openSidebar":null,"bindingPreference":"enabled","currentItemRoundness":"round","currentItemStrokeStyle":"solid","editingGroupId":null,"previousSelectedElementIds":{"cga_takeaway_text":true},"currentItemStrokeWidth":2,"selectedLinearElement":null,"cursorButton":"up","currentItemEndArrowhead":"arrow","currentItemFillStyle":"solid","currentItemFontSize":28,"penMode":false},"source":"https: